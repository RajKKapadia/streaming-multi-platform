{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "lint": {},
    "test": {
      "cache": false
    },
    "@studio/web#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  },
  "globalPassThroughEnv": [
    "PORT",
    "PUBLIC_APP_URL",
    "HOST_PASSCODE",
    "SESSION_SECRET",
    "LIVEKIT_URL",
    "LIVEKIT_API_KEY",
    "LIVEKIT_API_SECRET",
    "MEDIA_ROOT",
    "RECORDINGS_ENABLED",
    "RECORDINGS_ROOT",
    "EGRESS_RECORDINGS_ROOT",
    "RECORDING_RENDERER_URL",
    "FFMPEG_PATH",
    "NODE_ENV",
    "YOUTUBE_RTMP_URL",
    "YOUTUBE_STREAM_KEY",
    "TWITCH_STREAM_KEY",
    "X_RTMP_URL",
    "X_STREAM_KEY"
  ]
}
