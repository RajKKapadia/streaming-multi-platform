PORT=3001
PUBLIC_APP_URL=http://localhost:3001
HOST_PASSCODE=replace-with-a-long-private-passcode
SESSION_SECRET=replace-with-at-least-32-random-characters
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MEDIA_ROOT=
# Continuous recording needs self-hosted Egress and a folder shared with the API.
# Enabled automatically for localhost LiveKit; set true for a shared self-hosted server.
RECORDINGS_ENABLED=
# Defaults to <repository>/.local/recordings. Export the SAME value to Docker Compose.
RECORDINGS_ROOT=
# The bind mount path INSIDE Egress (compose.livekit.yaml uses /recordings).
EGRESS_RECORDINGS_ROOT=/recordings
# Optional renderer URL reachable by Egress. Localhost LiveKit defaults to the local API;
# other endpoints default to PUBLIC_APP_URL.
# For the local production build: http://127.0.0.1:3001
RECORDING_RENDERER_URL=
FFMPEG_PATH=ffmpeg
# Docker Compose only: export the API user's group ID if different from 1000.
RECORDINGS_GID=1000
# Optional YouTube server override; Twitch always has a built-in default server.
YOUTUBE_RTMP_URL=
YOUTUBE_STREAM_KEY=
TWITCH_STREAM_KEY=
X_RTMP_URL=
X_STREAM_KEY=
